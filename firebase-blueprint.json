{
  "entities": {
    "User": {
      "title": "User",
      "description": "System user with role and device information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "roleId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" },
        "trustedDevices": { "type": "array", "items": { "type": "string" } },
        "profileImage": { "type": "string" }
      },
      "required": ["id", "name", "email", "roleId", "status"]
    },
    "Role": {
      "title": "Role",
      "description": "User roles and their associated permissions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "permissions": {
          "type": "object",
          "properties": {
            "can_view_dashboard": { "type": "boolean" },
            "can_view_products": { "type": "boolean" },
            "can_add_products": { "type": "boolean" },
            "can_edit_products": { "type": "boolean" },
            "can_delete_products": { "type": "boolean" },
            "can_view_buying_price": { "type": "boolean" },
            "can_view_ads_plan": { "type": "boolean" },
            "can_edit_ads_plan": { "type": "boolean" },
            "can_view_content_plan": { "type": "boolean" },
            "can_edit_content_plan": { "type": "boolean" },
            "can_manage_users": { "type": "boolean" },
            "can_manage_roles": { "type": "boolean" },
            "can_manage_settings": { "type": "boolean" },
            "can_approve_devices": { "type": "boolean" }
          }
        }
      },
      "required": ["id", "name", "permissions"]
    },
    "DeviceRequest": {
      "title": "Device Request",
      "description": "Requests for device approval",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "deviceId": { "type": "string" },
        "deviceName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "deviceId", "status"]
    },
    "Product": {
      "title": "Product",
      "description": "E-commerce product information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "buyingPrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "websiteLink": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "ContentPlan": {
      "title": "Content Plan",
      "description": "Social media content planning items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string" },
        "theme": { "type": "string" },
        "visualDescription": { "type": "string" },
        "caption": { "type": "string" },
        "isDone": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "AdProduct": {
      "title": "Ad Product",
      "description": "Advertising campaign for a product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "videos": { "type": "array" },
        "notes": { "type": "array" },
        "platform": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "AppSetting": {
      "title": "App Setting",
      "description": "Global application settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyName": { "type": "string" },
        "companyLogo": { "type": "string" },
        "isSetupComplete": { "type": "boolean" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/roles/{roleId}": {
      "schema": "Role",
      "description": "User roles and permissions"
    },
    "/device_requests/{requestId}": {
      "schema": "DeviceRequest",
      "description": "Device approval requests"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Product inventory"
    },
    "/content_plans/{planId}": {
      "schema": "ContentPlan",
      "description": "Content planning items"
    },
    "/ad_products/{adId}": {
      "schema": "AdProduct",
      "description": "Ad campaigns"
    },
    "/settings/{settingId}": {
      "schema": "AppSetting",
      "description": "Global settings"
    }
  }
}
